# .env.example — copy this to .env and fill in your values
# Only set the key for the AI provider you want to use.

# ── AI Provider API Keys ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
MISTRAL_API_KEY=your-mistral-key-here
GROQ_API_KEY=your-groq-key-here

# ── Default Model ─────────────────────────────────────────────────────────────
# Which LLM to use for all scheduled jobs.
# Examples: claude-opus-4-6 | gpt-4o | gemini/gemini-1.5-pro | mistral/mistral-large-latest
CLOUDSEC_AI_MODEL=claude-opus-4-6

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Max LLM API calls per minute. Use this to stay within your provider's limits.
# Set to 0 to disable rate limiting entirely.
#
# Common limits by provider and tier:
#
#   Anthropic (Claude API)
#     Tier 1 (new paid account)  → 50 RPM
#     Tier 2                     → 1000 RPM
#     Tier 3 / 4                 → 2000+ RPM
#     → Start with 50, increase if you hit errors
#
#   OpenAI
#     Tier 1                     → 500 RPM
#     Tier 2+                    → 5000+ RPM
#     → 0 is fine for most paid accounts
#
#   Groq (free tier)             → 5 RPM
#   Gemini (free tier)           → 10 RPM
#
# Uncomment and set the value matching your provider:
CLOUDSEC_RATE_LIMIT=50    # Anthropic Tier 1 (safe default for Claude API)
# CLOUDSEC_RATE_LIMIT=0   # OpenAI paid / Anthropic Tier 2+
# CLOUDSEC_RATE_LIMIT=5   # Groq free tier
# CLOUDSEC_RATE_LIMIT=10  # Gemini free tier

# ── Debug Logging ─────────────────────────────────────────────────────────────
# Set to "true" to enable verbose LiteLLM request/response logging.
CLOUDSEC_DEBUG=false
